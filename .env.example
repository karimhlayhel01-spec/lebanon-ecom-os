# Postgres connection string (Neon, local Docker, or any managed Postgres).
# Required for the app and drizzle-kit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Examples:
# Local Docker:  postgresql://postgres:postgres@localhost:5432/lebanon_ecom
# Neon:          postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Neon pooler:   use the pooled connection string; the app sets prepare:false.

# Temporary demo restore (⚙ Settings → “Demo: restore Discovery”).
# Off unless DEMO_RESET=1|true. In production (NODE_ENV=production) also require
# DEMO_RESET_ALLOW_PRODUCTION=1|true — never enable casually on a live deploy.
# Restore wipes journey data then seeds invent/catalog Discovery (5 visible,
# Show more up to 25). No Serper/SerpAPI. Keeps login + onboarding.
# Non-production also offers Wipe to empty (no seed).
# DEMO_RESET=1
# DEMO_RESET_ALLOW_PRODUCTION=1

# --- Wave 2 Discovery (default off / soft; Approach A — jobs write, UI reads DB) ---
# Run order (local):
#   1) npm run db:migrate
#   2) Set flags below in .env (never commit secrets)
#   3) npm run discovery:intake    # Path 1 pool (seed; live SerpAPI when LIVE_SEARCH+key)
#   4) npm run discovery:score     # score cache (heuristic or live evidence)
#   5) npm run dev -- -p 3005    # Discovery page loads MUST NOT live-search
# Optional: npm run discovery:refresh  # intake then score
# Large pools: npm run discovery:score -- --limit=50
#
# Read Postgres product pool + score cache instead of in-memory catalog only.
# When on, curated catalog.ts is synced into the pool as seed/fallback.
# Also enables system demand/score accept gate (no founder paste),
# required Gemini “Why we suggested this” card copy (§6.1), and
# Discovery “Refresh suggestions” (close session → re-rank from live pool/scores).
# DISCOVERY_POOL_V2=1

# Allow scheduled intake/score jobs to call a live search/shopping API.
# Discovery page loads must NEVER live-search (Approach A). Default off.
# DISCOVERY_LIVE_SEARCH=1

# Competition×budget as rank penalty (soft). Set to 0|false only when ready to
# allow hard excludes (still prefer shadow logs before enforcing). Soft = default.
# DISCOVERY_SOFT_COMPETITION_BUDGET=1

# Search / shopping provider — Wave 2 Path 1 intake + score refresh jobs.
# Set DISCOVERY_LIVE_SEARCH=1 and the key(s) for your chosen vendor.
# Never commit real secrets — keys belong in .env only.
#
# Vendor for the SCORING legs (abroad demand, Lebanon demand, competition).
# serpapi (default) | brave | serper. Swappable by env alone: all implement the
# same DiscoverySearchProvider, and getDiscoverySearchProvider() is the only
# bind point. Path 1 intake ALWAYS stays on SerpAPI (needs shopping
# price/merchant); Brave and Serper cover scoring legs only.
# DISCOVERY_SEARCH_VENDOR=serpapi
#
# SerpAPI — Google Shopping for Path 1 intake; Google organic for scoring.
# SERPAPI_API_KEY=
# SEARCH_API_KEY=
#
# Brave Search — scoring legs only. Brave web search returns title/url/snippet
# but NO shopping price/merchant, which Path 1 intake requires, so Path 1 stays
# on SerpAPI even when DISCOVERY_SEARCH_VENDOR=brave. Set BOTH keys to run
# Brave scoring with SerpAPI intake; with only a Brave key, intake is seed-only.
# BRAVE_SEARCH_API_KEY=
#
# Serper.dev — scoring legs only (Google organic title/link/snippet). Preferred
# when SerpAPI quota is exhausted. Free trial is ONE-TIME (~2,500 queries), not
# a monthly refill. Path 1 intake still needs SERPAPI_API_KEY; with only
# SERPER_API_KEY, intake is seed-only (routing reports intake: "noop").
# DISCOVERY_SEARCH_VENDOR=serper
# SERPER_API_KEY=
#
# Monthly search-spend cap across ALL Discovery jobs (persisted ledger, UTC month
# buckets). Reaching it stops the run cleanly: last-known scores are preserved
# and the job exits 0. Default 100 — raise deliberately for a paid plan.
# For a Serper one-time ~2500 trial, keep this tight (e.g. 400) so a runaway
# job cannot burn the trial:
# DISCOVERY_SEARCH_MONTHLY_QUERY_CAP=100
# DISCOVERY_SEARCH_MONTHLY_QUERY_CAP=400
#
# (Unused alternatives kept for reference — not wired:)
# BING_SEARCH_API_KEY=
# GOOGLE_PSE_API_KEY=

# Score freshness on the Discovery card (WAVE-2 §7) — days before a market read
# reads as out of date. DISPLAY ONLY: never changes rank, strength, or accept
# gates. Default 7 (daily score cadence plus slack for missed cron runs).
# DISCOVERY_SCORE_STALE_AFTER_DAYS=7

# Card “Why we suggested this” (WAVE-2 §6.1) — Gemini narrates skill payloads only.
# Required when DISCOVERY_POOL_V2=1. Missing key → fail-closed UI (configure message).
# Never a scoring / pass-fail brain. Never paste the secret in chat — set in .env only.
# GEMINI_API_KEY=
# DISCOVERY_EXPLAIN_GEMINI_API_KEY=
# (Prefer DISCOVERY_EXPLAIN_GEMINI_API_KEY when both are set.)
# Optional model override (default gemini-2.5-flash; 2.0-flash is retired / 404):
# DISCOVERY_GEMINI_MODEL=gemini-2.5-flash

# --- Wave 3 Supplier (additive — default off) ---
# Live Import leads from public Alibaba/AliExpress SERP via Serper (Approach A:
# one-shot on first ensureSuppliers fill for a missing Import pool; heuristic
# pads/fallback). Reuses SERPER_API_KEY. Do not enable casually on a Serper trial.
# SUPPLIER_LIVE_LEADS=1
# Phase 3b — confirmed in-app Gmail send via Zapier/MCP (not yet wired; compose
# URL “Open in Gmail” works without this flag):
# SUPPLIER_GMAIL_SEND=1
