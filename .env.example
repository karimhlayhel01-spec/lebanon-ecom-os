# Postgres connection string (Neon, local Docker, or any managed Postgres).
# Required for the app and drizzle-kit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Examples:
# Local Docker:  postgresql://postgres:postgres@localhost:5432/lebanon_ecom
# Neon:          postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Neon pooler:   use the pooled connection string; the app sets prepare:false.

# Temporary demo journey reset (⚙ Settings → “Demo: reset journey”).
# Off unless DEMO_RESET=1|true. In production (NODE_ENV=production) also require
# DEMO_RESET_ALLOW_PRODUCTION=1|true — never enable casually on a live deploy.
# Wipe is transactional and keeps login + onboarding.
# DEMO_RESET=1
# DEMO_RESET_ALLOW_PRODUCTION=1

# --- Wave 2 Discovery (default off / soft; Approach A — jobs write, UI reads DB) ---
# Run order (local):
#   1) npm run db:migrate
#   2) Set flags below in .env (never commit secrets)
#   3) npm run discovery:intake    # Path 1 pool (seed; live SerpAPI when LIVE_SEARCH+key)
#   4) npm run discovery:score     # score cache (heuristic or live evidence)
#   5) npm run dev -- -p 3005    # Discovery page loads MUST NOT live-search
# Optional: npm run discovery:refresh  # intake then score
# Large pools: npm run discovery:score -- --limit=50
#
# Read Postgres product pool + score cache instead of in-memory catalog only.
# When on, curated catalog.ts is synced into the pool as seed/fallback.
# Also enables system demand/score accept gate (no founder paste),
# required Gemini “Why we suggested this” card copy (§6.1), and
# Discovery “Refresh suggestions” (close session → re-rank from live pool/scores).
# DISCOVERY_POOL_V2=1

# Allow scheduled intake/score jobs to call a live search/shopping API.
# Discovery page loads must NEVER live-search (Approach A). Default off.
# DISCOVERY_LIVE_SEARCH=1

# Competition×budget as rank penalty (soft). Set to 0|false only when ready to
# allow hard excludes (still prefer shadow logs before enforcing). Soft = default.
# DISCOVERY_SOFT_COMPETITION_BUDGET=1

# Search / shopping provider — Wave 2 Path 1 intake + (later) score refresh jobs.
# Wired provider: SerpAPI (Google Shopping for Path 1; Google organic for scoring).
# Set DISCOVERY_LIVE_SEARCH=1 and one of the keys below. Never commit real secrets.
# SERPAPI_API_KEY=
# SEARCH_API_KEY=
# (Unused alternatives kept for reference — not wired this pass:)
# BING_SEARCH_API_KEY=
# GOOGLE_PSE_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Card “Why we suggested this” (WAVE-2 §6.1) — Gemini narrates skill payloads only.
# Required when DISCOVERY_POOL_V2=1. Missing key → fail-closed UI (configure message).
# Never a scoring / pass-fail brain. Never paste the secret in chat — set in .env only.
# GEMINI_API_KEY=
# DISCOVERY_EXPLAIN_GEMINI_API_KEY=
# (Prefer DISCOVERY_EXPLAIN_GEMINI_API_KEY when both are set.)
# Optional model override (default gemini-2.5-flash; 2.0-flash is retired / 404):
# DISCOVERY_GEMINI_MODEL=gemini-2.5-flash
